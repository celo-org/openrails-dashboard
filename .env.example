# Loops House API key (ask Loops House / Celo Devs). Without it the page shows labelled example data.
LOOPS_API_KEY=
# Optional
# LOOPS_API_URL=https://www.loops.house/api/v1/celo/agents-on-open-rails
# LOOPS_API_AUTH_HEADER=Authorization   # "Authorization" sends "Bearer <key>"; set another header name to send the raw key
# Dune API key (Celo team). With it, hackathons that have `dune` queries in lib/hackathons.js show the official on-chain numbers.
DUNE_API_KEY=
